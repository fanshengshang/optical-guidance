# 复制为 backend/.env 后按需修改；不配则用默认值
DB_DRIVER=sqlite
# DATA_DIR=C:\Users\21449\Desktop\optical-guidance\optical-guidance-data
HOST=0.0.0.0
PORT=8002
RELOAD=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# 投影坐标系（料盒/取料位的坐标基准）
PROJ_W=1024
PROJ_H=768

# 摄像头
CAMERA_FRAME_WIDTH=1280
CAMERA_FRAME_HEIGHT=720

# 引导判定
HAND_DWELL_SEC=0.12
CALIB_SETTLE_SEC=0.45
CALIB_SAMPLES=5
RUNTIME_STREAM_INTERVAL_SECONDS=0.05
